<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            Notification Click Trampoline Activity — fires when user taps a
            SDK-displayed notification (body or action button). Replaces the
            previous BroadcastReceiver because Android 10+ restricts receivers
            from launching activities when the host app is in background or
            killed. An invisible activity launched via PendingIntent.getActivity
            counts as a foreground user action and can chain to the host app's
            deep-link target without restriction. Theme.NoDisplay + noHistory
            keeps it invisible.
        -->
        <activity
            android:name="com.thoughtnudge.sdk.TNNotificationClickActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!--
            Notification Dismiss Receiver — fires when user swipes away a
            SDK-displayed notification. Doesn't need to launch any activity
            (just reports the read event), so a BroadcastReceiver is fine.
        -->
        <receiver
            android:name="com.thoughtnudge.sdk.TNNotificationDismissReceiver"
            android:exported="false" />
    </application>

</manifest>
